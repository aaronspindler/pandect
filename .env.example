# Local development only. Generate both secrets before starting; see docs/development.md.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=pandect
POSTGRES_USER=pandect
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PANDECT_WEB_PORT=8000
# Compose publishes PostgreSQL on this loopback port for host-based uv commands.
PANDECT_DB_PORT=5432
# Use the externally reachable origin in invitation emails (no trailing path).
PANDECT_PUBLIC_ORIGIN=http://localhost:8000
PANDECT_INVITATION_DAYS=7
PANDECT_MAX_FILE_BYTES=104857600
PANDECT_MAX_TEXT_BYTES=1048576
PANDECT_MAX_BATCH_FILES=20
# Optional private inference services. No model is downloaded automatically.
# Follow docs/local-analysis.md before enabling the local-ai Compose profile.
# Compose URLs: http://local-text:8080 and http://local-transcription:8080.
# A URL explicitly designates an operator-controlled service, never a public API.
PANDECT_LOCAL_TEXT_URL=
PANDECT_LOCAL_TEXT_MODEL=Qwen3-8B-Q4_K_M
PANDECT_LOCAL_TEXT_SHA256=
PANDECT_LOCAL_TEXT_MODEL_FILE=./data/models/text.gguf
PANDECT_LOCAL_TEXT_CONTEXT_TOKENS=32768
PANDECT_LOCAL_TRANSCRIPTION_URL=
PANDECT_LOCAL_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
PANDECT_LOCAL_TRANSCRIPTION_SHA256=
PANDECT_LOCAL_TRANSCRIPTION_MODEL_FILE=./data/models/transcription.bin
PANDECT_LOCAL_AI_TOKEN=
PANDECT_LOCAL_AI_TIMEOUT=600
PANDECT_LOCAL_AI_MAX_REQUEST_BYTES=8388608
PANDECT_LOCAL_AI_MAX_RESPONSE_BYTES=2097152
PANDECT_LOCAL_AI_MAX_OUTPUT_TOKENS=4096
# Resource ceilings, not host minimums; tune against measured workloads.
PANDECT_LOCAL_AI_THREADS=4
PANDECT_LOCAL_AI_CPUS=4
PANDECT_LOCAL_TEXT_MEMORY=24g
PANDECT_LOCAL_TRANSCRIPTION_MEMORY=4g
# Optional Nominatim-compatible geocoder. No public default.
PANDECT_GEOCODER_URL=
# true means the operator controls this endpoint and its data handling.
PANDECT_GEOCODER_LOCAL=false
PANDECT_GEOCODER_NAME=
PANDECT_GEOCODER_VERSION=
PANDECT_GEOCODER_ATTRIBUTION=
PANDECT_GEOCODER_USER_AGENT=Pandect/0.1
PANDECT_GEOCODER_TIMEOUT=10
# Optional Overpass-compatible reference service. Empty URL disables map lookups.
# Configure attribution, source/version and service capacity; no public default.
PANDECT_MAP_CONTEXT_URL=
PANDECT_MAP_CONTEXT_LOCAL=false
# Empty means no basemap. A nonempty URL is visible to the browser, never secret.
# Configured tiles load automatically when the map opens, including public tiles.
PANDECT_MAP_TILE_URL=
# Additional plain-text attribution required by an alternative tile provider.
PANDECT_MAP_TILE_ATTRIBUTION=
PANDECT_MAP_CONTEXT_NAME=
PANDECT_MAP_CONTEXT_VERSION=
PANDECT_MAP_CONTEXT_ATTRIBUTION=
PANDECT_MAP_CONTEXT_USER_AGENT=Pandect/0.1
PANDECT_MAP_CONTEXT_TIMEOUT=10
# Earliest historical snapshot supported by that service (UTC date or timestamp).
# Empty means historical lookup is unavailable.
PANDECT_MAP_CONTEXT_HISTORY_START=
