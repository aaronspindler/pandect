# Docker Compose host settings. PANDECT_DATA_DIR may be relative or absolute.
PANDECT_DATA_DIR=./data
PANDECT_PORT=8000

# setup.sh replaces these values in a newly generated .env so bind-mounted data
# remains writable while the web and worker containers still run as non-root.
PANDECT_UID=1000
PANDECT_GID=1000

# Django settings used by the supported container runtime.
PANDECT_DEBUG=false
PANDECT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PANDECT_TIME_ZONE=UTC

# Optional processing locations inside PANDECT_DATA_DIR. Compose defaults these
# to /data/work and /data/models; web/worker mount models read-only and tasks
# never download model files.
# PANDECT_WORK_DIR=/data/work
# PANDECT_MODELS_DIR=/data/models

# Optional, item-consented Cloudflare AI Gateway processing. It is disabled by
# default; never commit a populated API token. The runtime token needs Account >
# Workers AI > Read for `/accounts/{account_id}/ai/*`. AI Gateway management
# permissions are needed only to create/configure the gateway. Payload logging
# and caching are disabled by the adapter.
PANDECT_CLOUDFLARE_AI_ENABLED=false
# PANDECT_CLOUDFLARE_ACCOUNT_ID=
# PANDECT_CLOUDFLARE_API_TOKEN=
PANDECT_CLOUDFLARE_GATEWAY_ID=pandect
PANDECT_CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
PANDECT_CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
PANDECT_CLOUDFLARE_TRANSCRIPTION_MODEL=@cf/deepgram/nova-3
PANDECT_CLOUDFLARE_CLIENT_TIMEOUT_SECONDS=300

# By default setup generates secret.key with mode 0600 in the configured data
# directory. An explicit value here overrides that file. Never commit a
# populated .env.
# PANDECT_SECRET_KEY=
