# Docker Compose host settings. PANDECT_DATA_DIR may be relative or absolute.
PANDECT_DATA_DIR=./data
PANDECT_PORT=8000

# setup.sh replaces these values in a newly generated .env so bind-mounted data
# remains writable while the web and worker containers still run as non-root.
PANDECT_UID=1000
PANDECT_GID=1000

# Django settings used by the supported container runtime.
PANDECT_DEBUG=false
PANDECT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PANDECT_TIME_ZONE=UTC

# By default setup generates secret.key with mode 0600 in the configured data
# directory. An explicit value here overrides that file. Never commit a
# populated .env.
# PANDECT_SECRET_KEY=
