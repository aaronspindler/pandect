{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pandect-investigator",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "Investigation", "class_name": "Investigation" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Investigation"] }]
}
