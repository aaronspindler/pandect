# Copy these values to both native Dokploy Application environments.
# Keep secrets private and use the managed PostgreSQL resource's credentials.
# Use a distinct strong random value for each blank secret. Keep these stable
# across redeploys; changing POSTGRES_PASSWORD does not rotate an existing DB role.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=pandect
POSTGRES_USER=pandect
POSTGRES_HOST=replace-with-managed-postgres-internal-hostname
POSTGRES_PORT=5432
DJANGO_DEBUG=false
PANDECT_ALLOW_SIGNUPS=false
DJANGO_ALLOWED_HOSTS=openpandect.com,localhost,127.0.0.1
PANDECT_PUBLIC_ORIGIN=https://openpandect.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://openpandect.com
DJANGO_SECURE_HSTS_SECONDS=86400
DJANGO_TRUST_PROXY_HEADERS=true
# Set only after verifying the trusted X-Forwarded-For hop count at ingress.
PANDECT_TRUSTED_PROXY_COUNT=0
# This example terminates public HTTPS at Cloudflare and uses HTTP internally.
DJANGO_SECURE_SSL_REDIRECT=false
# SMTP is optional for the first marketing deployment. Configure it before
# relying on password resets, verification messages, or collaboration invitations.
DJANGO_DEFAULT_FROM_EMAIL=pandect@openpandect.com
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
# No inference URLs, AI credentials, models, or local-ai services are configured.
