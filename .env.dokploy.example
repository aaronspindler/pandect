# Copy to both native Dokploy Application environments; see docs/operations.md.
# Generate distinct secrets and keep them stable across redeploys.
# Changing POSTGRES_PASSWORD does not rotate an existing database role.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_HOST=replace-with-managed-postgres-internal-hostname
PANDECT_PUBLIC_ORIGIN=https://openpandect.com
PANDECT_ALLOW_SIGNUPS=false
# Cloudflare configuration is shared by Django web and workers.
PANDECT_AI_ACCOUNT_ID=
PANDECT_AI_GATEWAY_ID=
PANDECT_AI_GATEWAY_TOKEN=
PANDECT_CLOUDFLARE_SEARCH_NAMESPACE=production
PANDECT_CLOUDFLARE_SEARCH_TOKEN=
PANDECT_AGENT_URL=
PANDECT_AGENT_SECRET=
# Optional per-model input/output prices for investigation cost estimates.
PANDECT_AI_PRICES_USD_PER_MILLION=
# Only trust headers from a controlled proxy; verify the client-IP hop count separately.
DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_SECURE_HSTS_SECONDS=86400
# Optional web-only origin telemetry. See docs/request-activity.md before enabling.
PANDECT_REQUEST_ACTIVITY_ENABLED=false
# Configure SMTP before account verification, password resets, or invitations.
# Optional SMTP and service configuration: see docs/development.md and docs/analysis.md.
